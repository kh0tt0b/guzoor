# Guzoor environment configuration
# Copy this file to .env.local and adjust values for local development.
# Vite exposes only variables prefixed with VITE_ to the client bundle.

# Public site name used in SEO meta tags.
VITE_SITE_NAME=Guzoor

# Absolute URL of the deployed site. Used for Open Graph / Twitter meta tags.
# Replace with your production domain (no trailing slash).
VITE_SITE_URL=https://guzoor.example.com
